# Chọn nhà cung cấp: groq | openrouter | claude | openai | mock
LLM_PROVIDER=groq

# Groq (Miễn phí, tốc độ cao)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Claude (Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-haiku-20241022

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Cấu hình chung cho Agent
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0

# Thời gian cố định của cửa hàng (dùng để tính ngày bảo hành / đổi trả đồng nhất)
SHOP_NOW=2026-11-10
DB_PATH=data/shop/work.db

